# Public values only: Expo embeds EXPO_PUBLIC_* into the client bundle.
# Development API defaults: the active feature slice uses the real backend.
# Mock composition was removed with the prototype; USE_MOCK_DATA=true currently
# fails fast because no mock drivers are bundled (R03 bundle isolation).
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_USE_MOCK_DATA=false
EXPO_PUBLIC_MOCK_LATENCY_MS=750
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/v1
EXPO_PUBLIC_API_TIMEOUT_MS=15000
# LiveKit server WebSocket URL (public; participant tokens stay backend-issued).
# Use ws:// only for local development; staging/production must use wss://.
EXPO_PUBLIC_LIVEKIT_URL=ws://localhost:7880
EXPO_PUBLIC_APP_NAME=TemanBule
EXPO_PUBLIC_APP_VERSION=1.0.0
