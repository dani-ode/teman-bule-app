{
  "expo": {
    "name": "TemanBule",
    "slug": "teman-bule-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "temanbule",
    "icon": "./assets/icon/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.flyup.temanbule.dev"
    },
    "android": {
      "package": "id.flyup.temanbule.dev",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/web/icon-512-maskable.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/icon/web/icon-192.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/icon/web/icon-512.png",
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "640f5c37-410a-4cfe-be62-128e4ea87cb9"
      }
    },
    "owner": "teman-bule"
  }
}
